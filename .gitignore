# ── Dados e resultados ───────────────────────────────────────────────
# 670 MB de PDFs do BTE e exports do MaxQDA; 170 MB de saídas.
# Tudo reproduzível ou obtível na origem — ver docs/dados/README.md.
data/
results/

# Exceção: os exemplos completos SÃO versionados (ver examples/README.md)
!examples/

# Código de terceiros (licenças próprias) e versões antigas do projeto
vendor/
archive/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# ── Ficheiros de projetos QDA (grandes e regeneráveis) ──────────────
# Exceto os que estão em examples/, incluídos explicitamente a seguir.
*.qdpx
*.mqda
!examples/**/*.qdpx

# PDFs originais dos exemplos: podem ser obtidos localmente para repetir a
# extração, mas não são redistribuídos na edição pública (ADR-0013).
examples/**/entrada/*.pdf
examples/**/entrada/versoes/**/*.pdf

# O siglas.csv da equipa: conhecimento local, não vem no repositório
# (docs/dados/README.md, «Siglas dos outorgantes»)
/siglas.csv

# ── Ambiente e sistema ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.local

# Configuração de máquina do Claude Code (settings.json é partilhável)
.claude/settings.local.json

# Dependências de lint e dados gerados
node_modules/
.ruff_cache/
